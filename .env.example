# ==============================================================================
# ServerSight — Environment Configuration Template
# Copy this file to .env or .env.local and configure your environment variables.
# ==============================================================================

# ─── Server Configuration (Backend) ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Telemetry Ingestion Authentication Token
# Required for edge agents sending telemetry via /api/ingest & /api/heartbeat.
AGENT_TOKEN=serversight-agent-secret-token

# Administrative & Fault-Injection Token
# Required to execute simulation and chaos testing endpoints.
ADMIN_TOKEN=serversight-admin-secret-token

# Enable Chaos / Reliability Testing Endpoints
# In production, set to false or leave unset to lock down simulation endpoints.
ENABLE_CHAOS_LAB=true

# Demonstration Mode
# Set to 'false' to start with an empty fleet and display authentic agents only.
DEMO_MODE=true


# ─── Frontend Configuration (Separately Hosted Dashboard) ───────────────────
# If the dashboard is hosted on a different domain or port (e.g. Vercel, Netlify):
# Specify the backend HTTP URL and WebSocket URL below.
# In local development using the Vite dev proxy, leave these empty for auto-routing.

# VITE_API_URL=http://localhost:4000
# VITE_WS_URL=ws://localhost:4000/ws

# Optional build-time development token (NEVER commit production secrets to Git)
# VITE_ADMIN_TOKEN=
